# FastAPI 和消费者进程共用的 RabbitMQ 连接配置。
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_VHOST=/

# 固定拓扑：仅在 FastAPI 启动阶段声明。
RABBITMQ_EXCHANGE=orders.direct
RABBITMQ_QUEUE=orders.created.queue
RABBITMQ_BINDING_KEY=order.created

# RabbitMQ 尚未就绪时，启动初始化会按以下配置重试。
TOPOLOGY_INITIALIZATION_ATTEMPTS=10
TOPOLOGY_INITIALIZATION_RETRY_SECONDS=1

# 设为正数可在崩溃演示中制造可观察的确认前处理窗口。
CONSUMER_PROCESSING_SECONDS=0
